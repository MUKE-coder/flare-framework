{
  "name": "flare-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "test": "pnpm build && vitest run",
    "typecheck": "pnpm -r --filter ./packages/** run typecheck",
    "release:check": "pnpm test && pnpm -r --filter ./packages/** publish --dry-run --no-git-checks",
    "release": "pnpm test && pnpm -r --filter ./packages/** publish"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "playwright-core": "^1.63.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}

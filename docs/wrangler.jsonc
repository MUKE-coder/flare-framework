{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-docs",
  "compatibility_date": "2026-09-18",
  // A fully static Starlight build served as Workers Static Assets — no
  // Worker code, no adapter. See https://developers.cloudflare.com/workers/static-assets/
  "assets": {
    "directory": "./dist"
  }
}

---
/**
 * The talk, as a page with the deck on it.
 *
 * Not a fullscreen deck: a normal page you can link someone to, with the slides framed
 * in it and a fullscreen button for when you are actually presenting. Each slide is a
 * fixed 1920x1080 stage scaled to the frame, so the layout never reflows — on a laptop,
 * in the frame, or on an unfamiliar projector it is the same slide at a different size.
 */
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import { slides } from "../talk/slides";
import type { Slide } from "../talk/types";

const deck: Slide[] = slides;
const title = "Flare, as presented";
const lede =
  "The whole talk. It starts on a job rather than a framework: a clinic needs a system, here are the seven tables it comes down to, and here are two developers building the same thing.";

/**
 * `backticked` spans become code and **starred** ones become bold. The content is ours,
 * so this needs no sanitising — and it stays this small on purpose: a slide that needs
 * more markup than this is a slide carrying too much.
 */
const md = (text: string) =>
  text
    .replace(/`([^`]+)`/g, '<code class="inline">$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Flare</title>
    <meta name="description" content={lede} />
    <style is:global>
      :root {
        /* Vercel's register: near-black, hairline borders, one accent, Geist throughout. */
        --bg: #000000;
        --panel: #0a0a0a;
        --ink: #ededed;
        --muted: #8f8f8f;
        --line: #1f1f1f;
        --ember: #ff6b35;
        --sans: "Geist Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono: "Geist Mono Variable", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      }
      /* The slide surfaces. A deck reads better light; the page around it stays dark. */
      .stage {
        --paper: #ffffff; --s-ink: #0a0a0a; --s-body: #404040;
        --s-muted: #737373; --s-rule: #e5e5e5; --s-surface: #fafafa; --s-ember: #e0450f;
      }
      .stage[data-tone="dark"] {
        --paper: #0a0a0a; --s-ink: #fafafa; --s-body: #c9c9c9;
        --s-muted: #8f8f8f; --s-rule: #262626; --s-surface: #131313; --s-ember: #ff6b35;
      }

      * { box-sizing: border-box; }
      html { background: var(--bg); }
      body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }

      .bar {
        border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 20px;
        padding: 0 24px; height: 56px; position: sticky; top: 0; z-index: 20;
        background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(8px);
      }
      .bar .brand { font-weight: 600; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); display: flex; align-items: center; gap: 9px; }
      .bar .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ember); }
      .bar nav { margin-left: auto; display: flex; gap: 20px; font-size: 14px; }
      .bar nav a { text-decoration: none; color: var(--muted); }
      .bar nav a:hover { color: var(--ink); }

      .page { max-width: 1180px; margin: 0 auto; padding: 56px 24px 96px; }
      .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; }
      h1.title { font-size: clamp(32px, 4vw, 46px); line-height: 1.05; letter-spacing: -0.035em; margin: 0 0 18px; font-weight: 600; }
      p.lede { font-size: 17px; line-height: 1.65; color: var(--muted); margin: 0 0 40px; max-width: 64ch; }

      /* The viewer: a framed 16:9 window with the deck inside it. */
      .viewer { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--panel); }
      .screen { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #fff; }
      .screen[data-dark="1"] { background: #0a0a0a; }
      .slot { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 140ms ease-out; }
      .slot.is-active { opacity: 1; visibility: visible; }
      .stage {
        position: absolute; top: 50%; left: 50%; width: 1920px; height: 1080px;
        transform-origin: center center; transform: translate(-50%, -50%) scale(var(--scale, 1));
        background: var(--paper); color: var(--s-ink);
        /* Deliberately generous. A slide that fills its frame is a slide nobody reads. */
        padding: 150px 160px; display: flex; flex-direction: column; justify-content: center; gap: 56px;
        isolation: isolate;
      }
      /*
       * A 120px grid, barely there, faded out at the edges. It gives the type something
       * to sit on without competing with it — at the back of a room it reads as texture
       * rather than as lines.
       */
      .stage::before {
        content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
        background-image:
          linear-gradient(var(--s-rule) 1px, transparent 1px),
          linear-gradient(90deg, var(--s-rule) 1px, transparent 1px);
        background-size: 120px 120px;
        opacity: 0.5;
        mask-image: radial-gradient(75% 80% at 50% 45%, #000 15%, transparent 78%);
      }

      .controls { border-top: 1px solid var(--line); display: flex; align-items: center; gap: 10px; padding: 10px 14px; font-family: var(--mono); font-size: 13px; color: var(--muted); }
      .controls button { font: inherit; color: var(--ink); background: #141414; border: 1px solid var(--line); border-radius: 7px; padding: 7px 13px; cursor: pointer; }
      .controls button:hover:not(:disabled) { background: #1d1d1d; }
      .controls button:disabled { opacity: 0.35; cursor: default; }
      .controls .spacer { margin-left: auto; }
      .progress { height: 2px; background: var(--ember); width: 0; transition: width 140ms ease-out; }
      .hint { font-size: 13px; color: var(--muted); margin: 14px 2px 0; }
      .hint kbd { font-family: var(--mono); font-size: 11px; border: 1px solid var(--line); border-radius: 5px; padding: 2px 6px; background: #141414; }

      .cta { margin-top: 56px; border: 1px solid var(--line); border-radius: 12px; padding: 28px; }
      .cta h2 { font-size: 19px; margin: 0 0 8px; letter-spacing: -0.02em; font-weight: 600; }
      .cta p { color: var(--muted); font-size: 15px; line-height: 1.6; margin: 0 0 20px; max-width: 72ch; }
      .cta .row { display: flex; gap: 10px; flex-wrap: wrap; }
      .cta a { text-decoration: none; font-size: 14px; font-weight: 500; border-radius: 8px; padding: 10px 16px; border: 1px solid var(--line); color: var(--ink); }
      .cta a.primary { background: var(--ink); color: #000; border-color: var(--ink); }

      /* ---- Slide internals ------------------------------------------------ */
      .s-eyebrow { font-family: var(--mono); font-size: 25px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--s-muted); margin: 0; }
      .s-head { font-size: 82px; font-weight: 600; line-height: 1.06; letter-spacing: -0.035em; margin: 0; max-width: 1480px; color: var(--s-ink); }
      .s-head.big { font-size: 128px; line-height: 1; letter-spacing: -0.05em; }
      .s-lede { font-size: 33px; line-height: 1.5; color: var(--s-body); margin: 0; max-width: 1300px; }
      .corner { position: absolute; top: 70px; right: 160px; font-family: var(--mono); font-size: 22px; color: var(--s-muted); }
      .num { position: absolute; bottom: 70px; right: 160px; font-family: var(--mono); font-size: 22px; color: var(--s-muted); }

      /* 200px fitted 'Flare Framework' with nothing to spare — one machine rendering
         Geist a hair wider and it wraps mid-word on stage. */
      .cover-title { font-size: 168px; font-weight: 600; letter-spacing: -0.06em; line-height: 0.9; margin: 0; color: var(--s-ember); }
      hr.rule { height: 1px; background: var(--s-rule); border: 0; margin: 0; }

      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 90px; }
      .item { display: flex; gap: 22px; align-items: baseline; font-size: 40px; font-weight: 500; letter-spacing: -0.02em; color: var(--s-ink); }
      .item .code { font-family: var(--mono); font-size: 27px; color: var(--s-ember); min-width: 74px; }

      pre.code {
        font-family: var(--mono); font-size: 31px; line-height: 1.6;
        background: var(--s-surface); border: 1px solid var(--s-rule); border-left: 3px solid var(--s-ember);
        border-radius: 10px; padding: 44px 50px; margin: 0; overflow: hidden; color: var(--s-ink);
        white-space: pre-wrap; word-break: break-word;
        font-variant-ligatures: none; font-feature-settings: "liga" 0, "calt" 0;
      }
      .s-lede strong, .caption strong, .col li strong, .facts li strong { color: var(--s-ink); font-weight: 600; }
      .caption { font-size: 27px; color: var(--s-muted); margin: 0; max-width: 1480px; line-height: 1.5; }

      .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
      .col h3 { font-family: var(--mono); font-size: 25px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--s-ember); margin: 0 0 26px; font-weight: 500; }
      .col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
      .col li { font-size: 35px; color: var(--s-ink); line-height: 1.3; }
      .col .note { font-family: var(--mono); font-size: 23px; color: var(--s-muted); margin-top: 26px; }

      /* One item lit, the rest dimmed. The dimming is the point: it holds the place. */
      .focus { display: grid; grid-template-columns: 0.78fr 1fr; gap: 90px; align-items: center; }
      .focus-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
      .focus-list li {
        display: flex; gap: 20px; align-items: baseline;
        font-size: 34px; font-weight: 500; letter-spacing: -0.02em;
        color: var(--s-ink); opacity: 0.17; transition: opacity 200ms;
      }
      .focus-list li.on { opacity: 1; font-weight: 600; }
      .focus-list li .c { font-family: var(--mono); font-size: 25px; color: var(--s-muted); min-width: 76px; }
      .focus-list li.on .c { color: var(--s-ember); }
      .focus-main { display: flex; flex-direction: column; gap: 40px; }
      .focus-main .s-head { font-size: 76px; }

      .portrait { display: grid; grid-template-columns: 420px 1fr; gap: 90px; align-items: center; }
      .portrait img { width: 420px; height: 420px; object-fit: cover; border-radius: 28px; border: 1px solid var(--s-rule); display: block; }
      .facts { list-style: none; margin: 36px 0 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
      .facts li { font-size: 31px; color: var(--s-body); line-height: 1.35; padding-left: 34px; position: relative; }
      .facts li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 14px; height: 2px; background: var(--s-ember); }
      .portrait-links { font-family: var(--mono); font-size: 25px; color: var(--s-muted); margin: 34px 0 0; }

      /* The tables as objects you can point at, before any of their detail. */
      .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; }
      .card { border: 1px solid var(--s-rule); border-radius: 18px; padding: 32px 30px; background: var(--s-surface); display: flex; flex-direction: column; gap: 12px; min-height: 250px; }
      .card .n { font-family: var(--mono); font-size: 22px; color: var(--s-ember); }
      .card .nm { font-family: var(--mono); font-size: 38px; font-weight: 600; color: var(--s-ink); letter-spacing: -0.02em; }
      .card .note { font-size: 25px; color: var(--s-muted); line-height: 1.35; }
      .card .hangs { font-family: var(--mono); font-size: 21px; color: var(--s-muted); margin-top: auto; padding-top: 14px; border-top: 1px solid var(--s-rule); }
      .card .hangs b { color: var(--s-ember); font-weight: 500; }

      table.cols-table { width: 100%; border-collapse: collapse; font-size: 30px; }
      table.cols-table th { font-family: var(--mono); font-size: 22px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--s-ember); text-align: left; padding: 0 0 18px; border-bottom: 1px solid var(--s-rule); font-weight: 500; }
      table.cols-table td { padding: 18px 28px 18px 0; border-bottom: 1px solid var(--s-rule); vertical-align: top; color: var(--s-body); }
      table.cols-table td.k { font-family: var(--mono); color: var(--s-ink); font-weight: 500; white-space: nowrap; }

      table.score { width: 100%; border-collapse: collapse; font-size: 28px; }
      table.score td { padding: 15px 0; border-bottom: 1px solid var(--s-rule); vertical-align: top; }
      table.score td.c { font-family: var(--mono); color: var(--s-ember); width: 86px; }
      table.score td.l { width: 600px; font-weight: 500; color: var(--s-ink); }
      table.score td.a { color: var(--s-body); }

      code.inline { font-family: var(--mono); font-size: 0.86em; background: color-mix(in srgb, var(--s-ember) 12%, transparent); color: var(--s-ember); padding: 2px 10px; border-radius: 5px; font-variant-ligatures: none; }

      @media (max-width: 720px) { .page { padding: 32px 16px 64px; } .controls { flex-wrap: wrap; } }
      @media print {
        .bar, .cta, .hint, .controls, .progress { display: none; }
        .viewer { border: 0; }
        .screen { aspect-ratio: auto; height: 100vh; }
        .slot { position: relative; opacity: 1; visibility: visible; height: 100vh; page-break-after: always; }
      }
    </style>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/"><span class="dot"></span> Flare</a>
      <nav>
        <a href="/start/quickstart/">Docs</a>
        <a href="/concepts/field-grammar/">Field grammar</a>
        <a href="https://github.com/MUKE-coder/flare-framework">GitHub</a>
      </nav>
    </header>

    <main class="page">
      <p class="eyebrow">JS Meetup · 2026</p>
      <h1 class="title">{title}</h1>
      <p class="lede">{lede}</p>

      <div class="viewer" id="viewer">
        <div class="screen" id="screen">
          {deck.map((slide, index) => (
            <section class="slot" id={slide.id}>
              <div class="stage" data-tone={slide.kind === "section" || slide.kind === "cover" ? "dark" : "light"}>
                {slide.kind === "cover" && (
                  <>
                    <p class="s-eyebrow">{slide.event}</p>
                    <h2 class="cover-title">{slide.title}</h2>
                    <p class="s-lede" style="font-size:40px;max-width:1560px">{slide.tagline}</p>
                    <hr class="rule" />
                    <p class="s-eyebrow" style="letter-spacing:0.08em">{slide.speaker}</p>
                  </>
                )}

                {slide.kind === "section" && (
                  <>
                    <p class="s-eyebrow">{slide.part}</p>
                    <h2 class="s-head big" set:html={slide.title} />
                    {slide.range && <p style="font-family:var(--mono);font-size:28px;color:var(--s-ember);letter-spacing:0.08em;margin:0">{slide.range}</p>}
                    {slide.note && <p class="s-lede" set:html={md(slide.note)} />}
                  </>
                )}

                {slide.kind === "statement" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    <h2 class="s-head" set:html={slide.title} />
                    {slide.body && <p class="s-lede" set:html={md(slide.body)} />}
                  </>
                )}

                {slide.kind === "list" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    <div class="grid-2">
                      {slide.items.map((it) => (
                        <p class="item"><span class="code">{it.code}</span>{it.label}</p>
                      ))}
                    </div>
                  </>
                )}

                {slide.kind === "problem" && (
                  <>
                    <p class="s-eyebrow">{slide.code}</p>
                    <h2 class="s-head">{slide.title}</h2>
                    <p class="s-lede" set:html={md(slide.body)} />
                  </>
                )}

                {slide.kind === "code" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    {slide.title && <h2 class="s-head" style="font-size:52px">{slide.title}</h2>}
                    <pre class="code">{slide.code}</pre>
                    {slide.caption && <p class="caption" set:html={md(slide.caption)} />}
                  </>
                )}

                {slide.kind === "split" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    <div class="cols">
                      <div class="col">
                        <h3>{slide.left.heading}</h3>
                        <ul>{slide.left.items.map((i) => <li set:html={md(i)} />)}</ul>
                        {slide.left.note && <p class="note" set:html={md(slide.left.note)} />}
                      </div>
                      <div class="col">
                        <h3>{slide.right.heading}</h3>
                        <ul>{slide.right.items.map((i) => <li set:html={md(i)} />)}</ul>
                        {slide.right.note && <p class="note" set:html={md(slide.right.note)} />}
                      </div>
                    </div>
                    {slide.caption && <p class="caption" set:html={md(slide.caption)} />}
                  </>
                )}

                {slide.kind === "focus" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    <div class="focus">
                      <ol class="focus-list">
                        {slide.items.map((it) => (
                          <li class={it.code === slide.active ? "on" : ""}>
                            <span class="c">{it.code}</span>{it.label}
                          </li>
                        ))}
                      </ol>
                      <div class="focus-main">
                        <h2 class="s-head" set:html={slide.title} />
                        {slide.body && <p class="s-lede" set:html={md(slide.body)} />}
                      </div>
                    </div>
                  </>
                )}

                {slide.kind === "portrait" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    <div class="portrait">
                      <img src={slide.image} alt="" width="420" height="420" />
                      <div>
                        <h2 class="s-head" style="font-size:88px">{slide.name}</h2>
                        <p class="s-lede" style="margin-top:18px">{slide.role}</p>
                        <ul class="facts">{slide.facts.map((f) => <li set:html={md(f)} />)}</ul>
                        {slide.links && <p class="portrait-links">{slide.links}</p>}
                      </div>
                    </div>
                  </>
                )}

                {slide.kind === "cards" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    {slide.title && <h2 class="s-head" style="font-size:62px">{slide.title}</h2>}
                    <div class="cards">
                      {slide.cards.map((c) => (
                        <div class="card">
                          <span class="n">{c.num}</span>
                          <span class="nm">{c.name}</span>
                          <span class="note">{c.note}</span>
                          {c.hangs && <span class="hangs">{c.hangs}</span>}
                        </div>
                      ))}
                    </div>
                    {slide.caption && <p class="caption" set:html={md(slide.caption)} />}
                  </>
                )}

                {slide.kind === "table" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    {slide.title && <h2 class="s-head" style="font-size:62px">{slide.title}</h2>}
                    <table class="cols-table">
                      <thead><tr>{slide.head.map((h) => <th>{h}</th>)}</tr></thead>
                      <tbody>
                        {slide.rows.map((row) => (
                          <tr>{row.map((cell, i) => <td class={i === 0 ? "k" : ""} set:html={md(cell)} />)}</tr>
                        ))}
                      </tbody>
                    </table>
                    {slide.caption && <p class="caption" set:html={md(slide.caption)} />}
                  </>
                )}

                {slide.kind === "scorecard" && (
                  <>
                    <p class="s-eyebrow">{slide.eyebrow}</p>
                    <h2 class="s-head" style="font-size:56px">{slide.title}</h2>
                    <table class="score">
                      <tbody>
                        {slide.rows.map((r) => (
                          <tr><td class="c">{r.code}</td><td class="l">{r.label}</td><td class="a" set:html={md(r.answer)} /></tr>
                        ))}
                      </tbody>
                    </table>
                  </>
                )}

                <span class="corner">flare-docs.codetotech.com</span>
                <span class="num">{String(index + 1).padStart(2, "0")} / {deck.length}</span>
              </div>
            </section>
          ))}
        </div>

        <div class="progress" id="progress"></div>
        <div class="controls">
          <button type="button" id="prev" aria-label="Previous slide">←</button>
          <button type="button" id="next" aria-label="Next slide">→</button>
          <span id="count">1 / {deck.length}</span>
          <span class="spacer"></span>
          <button type="button" id="full" aria-label="Present fullscreen">Present</button>
        </div>
      </div>

      <p class="hint">
        <kbd>←</kbd> <kbd>→</kbd> to page through, <kbd>F</kbd> for fullscreen. Every command in the deck was run before it went on a slide.
      </p>

      <section class="cta">
        <h2>Build the clinic yourself</h2>
        <p>
          The seven commands in the deck are the whole build. The field grammar page documents every type they use, including the
          conditional fields that only apply sometimes.
        </p>
        <div class="row">
          <a class="primary" href="/start/quickstart/">Start building →</a>
          <a href="/concepts/field-grammar/">Field grammar</a>
          <a href="https://github.com/MUKE-coder/flare-framework">GitHub</a>
        </div>
      </section>
    </main>

    <script is:inline>
      const screen = document.getElementById("screen");
      const viewer = document.getElementById("viewer");
      const slots = Array.from(document.querySelectorAll(".slot"));
      const prev = document.getElementById("prev");
      const next = document.getElementById("next");
      const count = document.getElementById("count");
      const progress = document.getElementById("progress");
      const full = document.getElementById("full");
      let at = 0;

      // The stage is a fixed 1920x1080 box; only its scale changes, so a slide looks the
      // same in the frame as it does filling a projector.
      function fit() {
        document.documentElement.style.setProperty("--scale", String(screen.clientWidth / 1920));
      }
      fit();
      new ResizeObserver(fit).observe(screen);

      function show(index, pushHash) {
        at = Math.min(Math.max(index, 0), slots.length - 1);
        slots.forEach((slot, i) => slot.classList.toggle("is-active", i === at));
        count.textContent = at + 1 + " / " + slots.length;
        prev.disabled = at === 0;
        next.disabled = at === slots.length - 1;
        progress.style.width = ((at + 1) / slots.length) * 100 + "%";
        // The frame takes the slide's own ground, so a dark slide has no white edge.
        screen.dataset.dark = slots[at].querySelector(".stage").dataset.tone === "dark" ? "1" : "0";
        if (pushHash !== false) history.replaceState(null, "", "#" + slots[at].id);
      }

      prev.addEventListener("click", () => show(at - 1));
      next.addEventListener("click", () => show(at + 1));
      full.addEventListener("click", () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else viewer.requestFullscreen?.();
      });

      addEventListener("keydown", (event) => {
        if (["ArrowRight", "PageDown", " "].includes(event.key)) { event.preventDefault(); show(at + 1); }
        else if (["ArrowLeft", "PageUp"].includes(event.key)) { event.preventDefault(); show(at - 1); }
        else if (event.key === "Home") show(0);
        else if (event.key === "End") show(slots.length - 1);
        else if (event.key.toLowerCase() === "f") full.click();
      });

      // A click on the slide advances, which is what a presenter remote sends.
      screen.addEventListener("click", () => show(at + 1));

      function fromHash() {
        const id = location.hash.slice(1);
        const found = slots.findIndex((slot) => slot.id === id);
        show(found >= 0 ? found : 0, false);
      }
      addEventListener("hashchange", fromHash);
      fromHash();
    </script>
  </body>
</html>

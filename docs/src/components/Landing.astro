    padding: 0.875rem 0.625rem 0.875rem 1.125rem;
  }

  .fl-install-line code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    color: var(--fl-ink);
    font-size: 0.875rem;
  }

  .fl-prompt {
    font-family: var(--sl-font-mono);
    color: var(--fl-ember);
    user-select: none;
  }

  .fl-copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--fl-rule);
    background: var(--fl-surface);
    color: var(--fl-muted);
    font: inherit;
    font-size: 0.75rem;
    padding: 0.3125rem 0.625rem;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .fl-copy:hover {
    color: var(--fl-ink);
    border-color: var(--fl-rule-strong);
  }

  .fl-copy svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* ---- Frame: side rails with ember crosshairs where sections meet them ---- */
  .fl-frame {
    max-width: var(--frame);
    margin: 0 auto;
    border-inline: 1px solid var(--fl-rule);
  }

  .fl-rail {
    position: relative;
    border-top: 1px solid var(--fl-rule);
  }

  .fl-rail::before,
  .fl-rail::after {
    content: "+";
    position: absolute;
    top: -0.8rem;
    font-family: var(--sl-font-mono);
    font-size: 1rem;
    line-height: 1.5rem;
    color: var(--fl-ember);
    pointer-events: none;
  }

  .fl-rail::before {
    left: -0.4rem;
  }

  .fl-rail::after {
    right: -0.4rem;
  }

  /* ---- Demo panel ---- */
  .fl-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.15fr);
    align-items: stretch;
    gap: 0;
    background: var(--fl-paper);
  }

  .fl-demo-pane {
    min-width: 0;
    padding: 1.5rem clamp(1rem, 2.5vw, 2rem) 1.75rem;
  }

  .fl-pane-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.78125rem;
    color: var(--fl-ink);
    padding-bottom: 0.875rem;
    margin-bottom: 1rem;
    border-bottom: 1px dashed var(--fl-rule-strong);
  }

  .fl-pane-note {
    margin-left: auto;
    font-family: var(--sl-font);
    color: var(--fl-muted);
    font-size: 0.75rem;
  }

  .fl-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--fl-rule-strong);
  }

  .fl-dot-ember {
    background: var(--fl-ember);
  }

  .fl-code {
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--fl-ink);
    overflow-x: auto;
  }

  .fl-code .k {
    color: #8250df;
  }
  .fl-code .s {
    color: var(--fl-ember-strong);
  }
  .fl-code .f {
    color: #0550ae;
  }
  .fl-code .n {
    color: #0550ae;
  }
  :global(:root:not([data-theme="light"])) .fl-code .k {
    color: #d2a8ff;
  }
  :global(:root:not([data-theme="light"])) .fl-code .f,
  :global(:root:not([data-theme="light"])) .fl-code .n {
    color: #79c0ff;
  }

  .fl-demo-arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    border-inline: 1px dashed var(--fl-rule);
    background: var(--fl-surface);
  }

  .fl-demo-arrow svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--fl-ember);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fl-gen {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
  }

  .fl-gen li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.3125rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--fl-rule) 60%, transparent);
    animation: fl-write 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 90ms + 250ms);
  }

  .fl-plus {
    color: var(--fl-ember);
    font-weight: 600;
  }

  .fl-path {
    color: var(--fl-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fl-what {
    font-family: var(--sl-font);
    font-size: 0.75rem;
    color: var(--fl-muted);
  }

  .fl-demo-foot {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    color: var(--fl-muted);
    max-width: 44ch;
  }

  @keyframes fl-write {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fl-gen li {
      animation: none;
    }
  }

  /* ---- Stack strip ---- */
  .fl-stack {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem clamp(1rem, 2.5vw, 2rem);
    background: var(--fl-page);
  }

  .fl-stack-label {
    flex: none;
    font-size: 0.8125rem;
    color: var(--fl-muted);
  }

  .fl-stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl-stack li {
    font-size: 0.9375rem;
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--fl-ink);
    padding-inline: 1rem;
    border-inline-start: 1px solid var(--fl-rule);
  }

  /* ---- Sections ---- */
  .fl-section {
    padding: clamp(3.5rem, 7vw, 5.5rem) clamp(1rem, 4vw, 3rem);
  }

  .fl-step {
    margin: 0 0 1.75rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fl-muted);
  }

  .fl-step span {
    color: var(--fl-ember);
    margin-right: 0.5rem;
  }

  .fl-section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: 2.75rem;
  }

  .fl-section-head h2,
  .fl-close h2 {
    margin: 0;
    font-size: clamp(1.875rem, 1.2rem + 2.6vw, 3rem);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--fl-ink);
    text-wrap: balance;
  }

  .fl-section-head p {
    margin: 0;
    max-width: 34rem;
    color: var(--fl-muted);
    font-size: 1.0625rem;
  }

  .fl-section-head code,
  .fl-stat-label code {
    color: var(--fl-ink);
  }

  /* Batteries: one ruled grid, not floating cards */
  .fl-batteries {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--fl-rule);
    border-left: 1px solid var(--fl-rule);
  }

  .fl-batteries li {
    border-right: 1px solid var(--fl-rule);
    border-bottom: 1px solid var(--fl-rule);
  }

  .fl-batteries a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem 1.375rem 1.625rem;
    text-decoration: none;
    background: var(--fl-paper);
    transition: background-color 0.15s ease;
  }

  .fl-batteries a:hover {
    background: var(--fl-surface);
  }

  .fl-batteries a:hover .fl-battery-name {
    color: var(--fl-ember-strong);
  }

  .fl-icon svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: var(--fl-ember);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 0.625rem;
  }

  .fl-battery-name {
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--fl-ink);
    transition: color 0.15s ease;
  }

  .fl-battery-body {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--fl-muted);
  }

  /* Generators */
  .fl-gens {
    border: 1px solid var(--fl-rule);
    border-radius: 0.875rem;
    background: var(--fl-paper);
    overflow: hidden;
  }

  .fl-gens-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
  }

  .fl-gens-copy {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .fl-gens-copy p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--fl-ink);
    max-width: 30ch;
  }

  .fl-link {
    font-size: 0.875rem;
    font-weight: 560;
    color: var(--fl-ember-strong);
    text-decoration: none;
  }

  .fl-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .fl-terminal {
    min-width: 0;
    background: var(--fl-surface);
    border-left: 1px solid var(--fl-rule);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
  }

  .fl-terminal-cmd {
    display: flex;
    gap: 0.625rem;
    padding: 1.125rem 1.375rem;
    border-bottom: 1px dashed var(--fl-rule-strong);
  }

  .fl-terminal-cmd code {
    color: var(--fl-ink);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .fl-terminal-out {
    margin: 0;
    padding: 1rem 1.375rem 1.25rem;
    list-style: none;
    line-height: 1.9;
    color: var(--fl-body);
  }

  .fl-created {
    color: var(--fl-ember);
    display: inline-block;
    width: 4.5rem;
  }

  .fl-step-mark {
    color: var(--fl-ember);
    font-weight: 600;
    margin-right: 0.5rem;
  }

  .fl-dim {
    color: var(--fl-muted);
  }

  .fl-ok {
    color: #1a7f37;
  }

  :global(:root:not([data-theme="light"])) .fl-ok {
    color: #3fb950;
  }

  /* Ship */
  .fl-ship {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.5rem;
  }

  .fl-terminal-tall {
    border: 1px solid var(--fl-rule);
    border-radius: 0.875rem;
  }

  .fl-ship-side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .fl-stat {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--fl-rule);
  }

  .fl-stat-number {
    font-size: clamp(3.5rem, 2.5rem + 3vw, 5rem);
    font-weight: 650;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--fl-ink);
  }

  .fl-stat-number span {
    color: var(--fl-ember);
    font-size: 0.5em;
    letter-spacing: -0.02em;
    margin-left: 0.1em;
  }

  .fl-stat-label {
    font-size: 0.9375rem;
    color: var(--fl-muted);
    max-width: 34ch;
  }

  .fl-share {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .fl-share p {
    margin: 0;
    color: var(--fl-muted);
    font-size: 0.9375rem;
  }

  .fl-share .fl-share-title {
    color: var(--fl-ink);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .fl-share-cmd {
    margin: 0.25rem 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--fl-rule);
    border-radius: 0.5rem;
    background: var(--fl-paper);
    color: var(--fl-ink);
  }

  /* Close + footer */
  .fl-close {
    text-align: center;
    padding: clamp(4rem, 8vw, 6rem) var(--gutter);
    background: var(--fl-paper);
  }

  .fl-close h2 {
    margin-inline: auto;
    max-width: 18ch;
  }

  .fl-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 1.5rem clamp(1rem, 2.5vw, 2rem);
    font-size: 0.8125rem;
    color: var(--fl-muted);
  }

  .fl-footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--fl-ink);
  }

  .fl-footer nav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .fl-footer a {
    color: var(--fl-muted);
    text-decoration: none;
  }

  .fl-footer a:hover {
    color: var(--fl-ink);
  }


  /* ---- Hero showcase: npm create, and the app it makes ---- */
  .fl-showcase {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.45fr);
    gap: 1.25rem;
    max-width: 72rem;
    margin: 3.5rem auto 0;
    text-align: left;
    align-items: start;
  }

  .fl-showcase-term {
    border-radius: 0.875rem;
    background: #141414;
    color: #e5e5e5;
    border: 1px solid #2a2a2a;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .fl-term-bar,
  .fl-browser-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
  }

  .fl-term-bar {
    border-bottom: 1px solid #262626;
  }

  .fl-term-bar span,
  .fl-browser-bar span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: #3a3a3a;
  }

  .fl-browser-bar span {
    background: var(--fl-rule-strong);
  }

  .fl-browser-bar code {
    margin-left: 0.75rem;
    flex: 1;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    background: var(--fl-surface);
    color: var(--fl-muted);
    font-size: 0.75rem;
  }

  .fl-term {
    list-style: none;
    margin: 0;
    padding: 1rem 1.125rem 1.25rem;
    font-family: var(--sl-font-mono);
    font-size: 0.78125rem;
    line-height: 1.95;
  }

  .fl-term li {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    animation: fl-write 0.35s ease-out both;
    animation-delay: calc(var(--i) * 180ms + 200ms);
  }

  .fl-term .fl-dim {
    color: #8a8a8a;
  }

  .fl-term .fl-prompt,
  .fl-ok-mark {
    color: #ff6b35;
  }

  .fl-term-choice {
    color: #fafafa;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .fl-term li {
      animation: none;
    }
  }

  .fl-showcase-app {
    border: 1px solid var(--fl-rule);
    border-radius: 0.875rem;
    background: var(--fl-paper);
    overflow: hidden;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.18);
  }

  .fl-browser-bar {
    border-bottom: 1px solid var(--fl-rule);
  }

  .fl-showcase-app img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 860;
  }

  .fl-theme-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.75rem;
    border-top: 1px solid var(--fl-rule);
  }

  .fl-theme-chips button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--fl-rule);
    border-radius: 999px;
    background: var(--fl-paper);
    color: var(--fl-muted);
    font: inherit;
    font-size: 0.78125rem;
    cursor: pointer;
  }

  .fl-theme-chips button[aria-pressed="true"] {
    border-color: var(--fl-ink);
    color: var(--fl-ink);
  }

  .fl-swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .fl-swatch-default { background: #5b5bd6; }
  .fl-swatch-coral { background: linear-gradient(135deg, #e61e4d, #d70466); }
  .fl-swatch-amber { background: #ffd814; }
  .fl-swatch-sky { background: #0051c3; }
  .fl-swatch-mono { background: #0a0a0a; }
  .fl-swatch-emerald { background: #3ecf8e; }

  .fl-gens-tabs button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  /* ---- Look: every theme's sign-in and home page ---- */
  .fl-looks {
    border: 1px solid var(--fl-rule);
    border-radius: 0.875rem;
    background: var(--fl-paper);
    overflow: hidden;
  }

  .fl-look-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 1.25rem;
  }

  .fl-look-panel figure,
  .fl-shot {
    margin: 0;
  }

  .fl-look-panel img,
  .fl-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--fl-rule);
    border-radius: 0.625rem;
  }

  .fl-look-panel figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--fl-muted);
  }

  .fl-look-note {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.875rem;
    color: var(--fl-muted);
  }

  .fl-look-note code,
  .fl-section-head code {
    color: var(--fl-ink);
  }

  /* ---- Secure ---- */
  .fl-secure {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 2rem;
    align-items: start;
  }

  .fl-methods {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--fl-rule);
  }

  .fl-methods li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--fl-rule);
  }

  .fl-method-name {
    font-weight: 600;
    color: var(--fl-ink);
    letter-spacing: -0.01em;
  }

  .fl-method-body {
    font-size: 0.9rem;
    color: var(--fl-muted);
  }

  .fl-method-more {
    border-bottom: 0 !important;
  }

  .fl-shot {
    max-height: 34rem;
    overflow: hidden;
    border-radius: 0.625rem;
    mask-image: linear-gradient(to bottom, black 80%, transparent);
  }

  /* ---- Code examples ---- */
  .fl-examples {
    margin-top: 2.5rem;
  }

  .fl-examples-title {
    margin: 0 0 1rem;
    font-weight: 600;
    color: var(--fl-ink);
    letter-spacing: -0.015em;
  }

  .fl-examples .fl-gens-tabs {
    border: 1px solid var(--fl-rule);
    border-bottom: 0;
    border-radius: 0.875rem 0.875rem 0 0;
    background: var(--fl-paper);
  }

  .fl-examples :global(.expressive-code .frame) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .fl-examples :global(.expressive-code) {
    margin: 0;
  }

  /* ---- FAQ ---- */
  .fl-faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: 2rem;
  }

  .fl-faq-title {
    margin: 0;
    font-size: clamp(1.875rem, 1.2rem + 2.6vw, 3rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    color: var(--fl-ink);
  }

  .fl-faq details {
    border-bottom: 1px solid var(--fl-rule);
  }

  .fl-faq details:first-child {
    border-top: 1px solid var(--fl-rule);
  }

  .fl-faq summary {
    cursor: pointer;
    list-style: none;
    padding: 1.125rem 2rem 1.125rem 0;
    font-weight: 560;
    color: var(--fl-ink);
    position: relative;
  }

  .fl-faq summary::-webkit-details-marker {
    display: none;
  }

  .fl-faq summary::after {
    content: "+";
    position: absolute;
    right: 0.25rem;
    font-family: var(--sl-font-mono);
    color: var(--fl-ember);
    transition: transform 0.15s ease;
  }

  .fl-faq details[open] summary::after {
    transform: rotate(45deg);
  }

  .fl-faq details p {
    margin: 0 0 1.25rem;
    max-width: 60ch;
    color: var(--fl-muted);
  }

  /* ---- Narrow screens ---- */
  @media (max-width: 64rem) {
    .fl-batteries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 50rem) {
    .fl-showcase,
    .fl-look-panel,
    .fl-secure,
    .fl-faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .fl-demo {

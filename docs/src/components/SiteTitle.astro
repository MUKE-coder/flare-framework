---
import Default from "@astrojs/starlight/components/SiteTitle.astro";
import { FLARE_VERSION, RELEASE_URL } from "../version";
---

<div class="fl-title">
  <Default />
  <a class="fl-version" href={RELEASE_URL} title={`Docs for Flare ${FLARE_VERSION}: release notes`}>v{FLARE_VERSION}</a>
</div>

<style>
  .fl-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .fl-version {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--fl-rule);
    border-radius: 999px;
    color: var(--fl-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .fl-version:hover {
    border-color: var(--fl-ember);
    color: var(--fl-ink);
  }
</style>

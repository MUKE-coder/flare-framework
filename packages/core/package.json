{
  "name": "@flaredev/core",
  "version": "0.1.2",
  "description": "Flare runtime: resource descriptors, field grammar, and Cloudflare-native helpers",
  "license": "MIT",
  "author": "Muke Johnbaptist",
  "homepage": "https://flare-docs.codetotech.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MUKE-coder/flare-framework.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/MUKE-coder/flare-framework/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "vinext",
    "fullstack",
    "framework",
    "d1",
    "drizzle",
    "generator",
    "admin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./realtime": {
      "types": "./dist/realtime/client.d.ts",
      "import": "./dist/realtime/client.js"
    },
    "./realtime/server": {
      "types": "./dist/realtime/server.d.ts",
      "import": "./dist/realtime/server.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    },
    "./security/server": {
      "types": "./dist/security/worker.d.ts",
      "import": "./dist/security/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "drizzle-orm": "^0.45.2",
    "sql.js": "^1.14.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}

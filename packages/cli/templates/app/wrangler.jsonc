{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__APP_NAME__",
  "compatibility_date": "__COMPAT_DATE__",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        // Realtime channels (see lib/realtime.ts). Each channel is one Durable
        // Object instance created on demand; wrangler provisions nothing upfront.
        "name": "FLARE_REALTIME",
        "class_name": "RealtimeChannel"
      },
      {
        // Rate limit counters (see lib/rate-limit.ts). One instance per resource and
        // action, holding a count per caller — so a limited endpoint costs one object
        // request, not one per person calling it.
        "name": "FLARE_RATE_LIMIT",
        "class_name": "RateLimitCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeChannel"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimitCounter"]
    }
  ],
  "d1_databases": [
    {
      // No database_id: wrangler creates the database on first deploy and
      // uses a local SQLite file during development.
      "binding": "DB",
      "database_name": "__APP_NAME__-db",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // Data cache (see `cache.data` in vite.config.ts). No id: wrangler creates
      // the namespace on first deploy; locally it's simulated on disk.
      "binding": "VINEXT_KV_CACHE"
    }
  ],
  "r2_buckets": [
    {
      // Simulated locally. No bucket needs creating first: wrangler provisions
      // missing resources on deploy.
      "binding": "STORAGE",
      "bucket_name": "__APP_NAME__-storage"
    }
  ]
}

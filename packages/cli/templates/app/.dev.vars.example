# Local secrets for `vinext dev` / `wrangler dev`. Copy to .dev.vars (git-ignored).
# In production set them with `wrangler secret put <NAME>`.

# Signs sessions, tokens, and storage URLs. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Only needed on a custom domain, e.g. https://example.com
# BETTER_AUTH_URL=

# Resend (https://resend.com/api-keys). Leave empty locally to print emails to the console.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Acme <hello@acme.com>"
MAIL_FROM=

# Where uploads go. The default is the bound STORAGE bucket, which needs nothing set.
# Set a driver only to send files to a CDN instead — see the file-uploads guide.
# STORAGE_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# STORAGE_DRIVER=uploadthing
# UPLOADTHING_TOKEN=            # the app id is inside it; there is no second variable

# Both serve files from their own CDN, so a read URL is public and does not expire.
# Set this to keep every read signed and proxied by the app instead.
# STORAGE_PUBLIC=false

# Images are shrunk in the browser before upload (about 20x smaller). Set this to turn
# it off and send the original bytes. It is read at build time, so changing it means a
# rebuild rather than a restart.
# NEXT_PUBLIC_OPTIMISE_UPLOADS=false

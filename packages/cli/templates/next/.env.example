# Copy to .env. `flare create` already wrote one with a secret and the local service
# addresses below, so this file is here for the values you change when you deploy.
#
# Two ways to run the services this app needs:
#
#   With Docker     docker compose up -d     — Postgres, MinIO and Redis on your machine.
#                                              The values below already match it.
#   Without Docker  Neon, Cloudflare R2 and Upstash. Replace the values below with theirs.
#
# Nothing in the app knows which you chose: MinIO speaks S3 like R2, and the Redis proxy
# speaks Upstash's REST protocol.

# Postgres. Docker: the compose file. Hosted: Neon (Dashboard -> Connection string),
# pooled rather than direct.
DATABASE_URL=postgresql://flare:flare@127.0.0.1:5432/app

# Sessions and signed upload URLs. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# A bare origin: no trailing slash, or every sign-in returns 403.
BETTER_AUTH_URL=http://localhost:3000

# File uploads. Docker: MinIO, below. Hosted: an R2 bucket (Cloudflare -> R2 -> Manage
# API tokens). R2 serves what it stores for free, which is why it is here rather than
# Blob storage.
R2_ENDPOINT=http://127.0.0.1:9000
R2_BUCKET=app-uploads
R2_ACCESS_KEY_ID=flare
R2_SECRET_ACCESS_KEY=flare-secret-123

# Optional. Rate limits and anything that has to be true across every instance.
# Docker: the serverless-redis-http proxy. Hosted: Upstash.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=flare-local-token

# Optional. Without these, email is printed to the console instead of sent.
RESEND_API_KEY=
MAIL_FROM=

# Postgres, from your Neon project (Dashboard → Connection string).
DATABASE_URL=

# Sessions and signed upload URLs. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# File uploads, on an R2 bucket (Cloudflare → R2 → Manage API tokens).
# R2 serves what it stores for free, which is why it's here rather than Blob storage.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Rate limits and anything that has to be true across every instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Without these, email is printed to the console instead of sent.
RESEND_API_KEY=
MAIL_FROM=

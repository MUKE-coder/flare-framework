// The part of the schema that is yours.
//
// Your resources live in resources.prisma beside this file, written by
// `flare gen resource` from the descriptors in resources/. This file is never
// regenerated: the generator, the datasource, the tables Better Auth needs and the two
// Flare's own dashboard uses are all here, and yours to edit.

// Prisma 7's generator, not a leftover from 6: `prisma-client` (the v7 provider; v6's
// was `prisma-client-js`), and `output` is required — v7 no longer generates into
// node_modules. The client lands in lib/generated/, git-ignored and rebuilt on every
// install and `flare migrate`.
generator client {
  provider = "prisma-client"
  output   = "../../lib/generated/prisma"
}

// No `url` here — that is also Prisma 7: the connection string lives in
// prisma.config.ts, which reads DATABASE_URL from .env.
datasource db {
  provider = "postgresql"
}

/// Better Auth: the signed-in person.
model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  /// Set with `flare user:role`; the dashboard's policies read it.
  role            String?
  banned          Boolean?
  banReason       String?   @map("ban_reason")
  banExpires      DateTime? @map("ban_expires")
  twoFactorEnabled Boolean? @map("two_factor_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions   Session[]
  accounts   Account[]
  passkeys   Passkey[]
  twoFactors TwoFactor[]
  auditLogs  AuditLog[]
  savedViews SavedView[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Passkey {
  id           String    @id @default(uuid())
  name         String?
  publicKey    String    @map("public_key")
  userId       String    @map("user_id")
  credentialID String    @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model TwoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  /// Better Auth checks for these three at startup and refuses to run without them.
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

/// Who changed what, written by the dashboard's actions.
/// Roles a user can hold (`user.role` from Better Auth's admin plugin). Register them
/// from the dashboard's Roles screen or with `flare role:add <name>`.
model Role {
  name      String   @id
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("role")
}

/// Permissions granted from the dashboard, on top of the policies in your code.
///
/// A row says "this role may do this to this resource". It can only ever *widen* what
/// `policies/*.policy.ts` already allows — see `withGrants` in @flaredev/core. A
/// resource with no policy file is open to every signed-in user, and no row here
/// changes that; the roles screen says so rather than pretending otherwise.
model RolePermission {
  id        String   @id @default(uuid())
  /// The role's name, as in the Role table and user.role.
  role      String
  /// The resource's descriptor name, e.g. "Invoice".
  resource  String
  /// "read", "create", "update" or "delete".
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  /// One row per cell of the matrix: ticking a box twice is the same tick.
  @@unique([role, resource, action])
  @@map("role_permission")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  resource     String
  recordId     String?  @map("record_id")
  recordLabel  String?  @map("record_label")
  userId       String?  @map("user_id")
  userEmail    String?  @map("user_email")
  changes      Json?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resource])
  @@index([createdAt])
  @@map("audit_log")
}

/// A saved set of filters on a resource's table.
model SavedView {
  id        String   @id @default(uuid())
  name      String
  resource  String
  query     String
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource])
  @@map("saved_views")
}

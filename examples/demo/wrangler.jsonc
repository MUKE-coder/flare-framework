{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // No database_id: wrangler creates the database on first deploy and
      // uses a local SQLite file during development.
      "binding": "DB",
      "database_name": "demo-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Simulated locally. No bucket needs creating first: wrangler provisions
      // missing resources on deploy.
      "binding": "STORAGE",
      "bucket_name": "demo-storage"
    }
  ]
}

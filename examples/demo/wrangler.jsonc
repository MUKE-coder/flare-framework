{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FLARE_REALTIME",
        "class_name": "RealtimeChannel"
      },
      {
        "name": "FLARE_SECURITY_MONITOR",
        "class_name": "SecurityMonitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeChannel"]
    },
    {
      "tag": "flare-security-v1",
      "new_sqlite_classes": [
        "SecurityMonitor"
      ]
    }
  ],
  "d1_databases": [
    {
      // No database_id: wrangler creates the database on first deploy and
      // uses a local SQLite file during development.
      "binding": "DB",
      "database_name": "demo-db",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // Data cache (see `cache.data` in vite.config.ts). No id: wrangler creates
      // the namespace on first deploy; locally it's simulated on disk.
      "binding": "VINEXT_KV_CACHE"
    },
    {
      "binding": "FLARE_SECURITY"
    }
  ],
  "r2_buckets": [
    {
      // Simulated locally. No bucket needs creating first: wrangler provisions
      // missing resources on deploy.
      "binding": "STORAGE",
      "bucket_name": "demo-storage"
    }
  ],
  "ratelimits": [
    {
      "name": "FLARE_RATE_LIMIT",
      "namespace_id": "5923",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
